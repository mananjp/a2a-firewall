# Database — matches docker-compose postgres service
DATABASE_URL=postgresql+asyncpg://a2a:a2apassword@localhost:5432/a2afirewall

# Groq — LLM inference for Layer 4 semantic analysis
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=2.0
GROQ_CACHE_TTL_SECONDS=3600
GROQ_CACHE_ENABLED=true

# Security — CHANGE THESE before any real deployment
SECRET_KEY=change-this-to-a-256-bit-random-string
API_KEY_SALT=change-this-salt-too

# OpenTelemetry — points at local Jaeger (docker-compose service name "jaeger")
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=a2a-firewall
# Set to "true" to disable OTEL in tests/CI
# OTEL_SDK_DISABLED=true

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173
MAX_PAYLOAD_BYTES=102400
DEFAULT_FAIL_MODE=closed
WORKSPACE_DEFAULT_DENY=true
GROQ_THRESHOLD=0.3
BLOCK_THRESHOLD=0.8
REVIEW_THRESHOLD=0.5

# Rate limiting
RATE_LIMIT_ENABLED=true
# Backend: "memory" (default, single-process) or "postgres" (distributed)
RATE_LIMIT_BACKEND=memory
WORKSPACE_RATE_LIMIT_PER_MIN=1000
AGENT_INSPECT_RATE_LIMIT_PER_MIN=60

# Identity & Delegation
# Max delegation hops in a chain (research recommendation: 2-3)
DELEGATION_MAX_DEPTH=3
DELEGATION_DEFAULT_EXPIRY_SECONDS=3600
IDENTITY_CARD_TTL_SECONDS=86400

# Intent-binding
INTENT_DRIFT_THRESHOLD=0.7

# Security Expansion: CVE / CVSS
# Optional NVD API key — increases rate limit from 5 req/30s to 50 req/30s
# Register at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Minimum CVSS v3 base score to flag a component as vulnerable (default: 7.0 = High)
CVE_CVSS_THRESHOLD=7.0

# Security Expansion: IDS/IPS
# Action mode: monitor (log only) | block (default) | block_and_suspend (full IPS)
IPS_DEFAULT_MODE=block
# Number of critical violations within the sliding window before auto-suspending an agent
IPS_AUTO_SUSPEND_THRESHOLD=3
# Sliding window size in minutes for the auto-suspend counter
IPS_AUTO_SUSPEND_WINDOW_MINUTES=10

# ---- Transparent Proxy / System-Wide Redirection ----
# SO_MARK (Linux) set on the proxy's own outbound sockets to avoid the
# iptables REDIRECT loop (the proxy's upstream traffic must never re-enter
# itself). The iptables rules skip packets carrying this mark.
A2A_FW_MARK=0xA2A1
# Install iptables PREROUTING/OUTPUT REDIRECT rules capturing all outbound
# TCP 80/443 transparently to the proxy (Linux + root only).
A2A_REDIRECT_ENABLED=false
# Route proxy traffic through the full 5-layer run_inspection pipeline
# (requires DATABASE_URL + GROQ_API_KEY). The installer exports this as ON
# by default (A2A_INSPECT_ENABLED=1) so captured traffic is never left
# uninspected; it degrades to allow if Postgres/Groq are down. Set false to
# use only the fast built-in deterministic gate.
A2A_INSPECT_ENABLED=true
# Installer commands are no-ops (log only) unless this is false or --no-dry-run.
A2A_DEFAULT_DRY_RUN=true
# OS uid of a DEDICATED user that RUNS the governed agents. When set, iptables
# REDIRECT is scoped with --uid-owner so unrelated processes (browser, email,
# banking) are never intercepted. This is NOT zero-touch: you must (1) create
# the user (`sudo useradd --system --create-home a2a-agent`) and (2) actually
# run agents as that user (`sudo -u a2a-agent claude`). If unset or mismatched
# the --uid-owner rules match NOTHING and no traffic is captured (silent no-op).
# See "Prepare the agent user" in docs/RUNBOOK.md.
# A2A_AGENT_UID=1001
