# Database — matches docker-compose postgres service
DATABASE_URL=postgresql+asyncpg://a2a:a2apassword@localhost:5432/a2afirewall

# Groq — LLM inference for Layer 4 semantic analysis
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=2.0
GROQ_CACHE_TTL_SECONDS=3600
GROQ_CACHE_ENABLED=true

# Security — CHANGE THESE before any real deployment
SECRET_KEY=change-this-to-a-256-bit-random-string
API_KEY_SALT=change-this-salt-too

# OpenTelemetry — points at local Jaeger (docker-compose service name "jaeger")
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=a2a-firewall
# Set to "true" to disable OTEL in tests/CI
# OTEL_SDK_DISABLED=true

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173
MAX_PAYLOAD_BYTES=102400
DEFAULT_FAIL_MODE=closed
WORKSPACE_DEFAULT_DENY=true
GROQ_THRESHOLD=0.3
BLOCK_THRESHOLD=0.8
REVIEW_THRESHOLD=0.5

# Rate limiting
RATE_LIMIT_ENABLED=true
# Backend: "memory" (default, single-process) or "postgres" (distributed)
RATE_LIMIT_BACKEND=memory
WORKSPACE_RATE_LIMIT_PER_MIN=1000
AGENT_INSPECT_RATE_LIMIT_PER_MIN=60

# Identity & Delegation
# Max delegation hops in a chain (research recommendation: 2-3)
DELEGATION_MAX_DEPTH=3
DELEGATION_DEFAULT_EXPIRY_SECONDS=3600
IDENTITY_CARD_TTL_SECONDS=86400

# Intent-binding
INTENT_DRIFT_THRESHOLD=0.7

# Security Expansion: CVE / CVSS
# Optional NVD API key — increases rate limit from 5 req/30s to 50 req/30s
# Register at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Minimum CVSS v3 base score to flag a component as vulnerable (default: 7.0 = High)
CVE_CVSS_THRESHOLD=7.0

# Security Expansion: IDS/IPS
# Action mode: monitor (log only) | block (default) | block_and_suspend (full IPS)
IPS_DEFAULT_MODE=block
# Number of critical violations within the sliding window before auto-suspending an agent
IPS_AUTO_SUSPEND_THRESHOLD=3
# Sliding window size in minutes for the auto-suspend counter
IPS_AUTO_SUSPEND_WINDOW_MINUTES=10
