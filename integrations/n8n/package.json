{
  "name": "n8n-a2a-firewall",
  "version": "0.1.0",
  "description": "n8n nodes for A2A Firewall: inspect agent, tool and LLM traffic, sanitise tool results, and tokenize sensitive data.",
  "keywords": [
    "n8n-community-node-package",
    "ai",
    "agents",
    "security",
    "firewall",
    "a2a",
    "mcp",
    "dlp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mananjp/a2a-firewall/tree/main/integrations/n8n",
  "author": {
    "name": "Manan Jayeshkumar Panchal"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mananjp/a2a-firewall.git",
    "directory": "integrations/n8n"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/A2aFirewallApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/A2aFirewallGuard/A2aFirewallGuard.node.js",
      "dist/nodes/A2aFirewallInspectResponse/A2aFirewallInspectResponse.node.js",
      "dist/nodes/A2aFirewallDlp/A2aFirewallDlp.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.30.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
